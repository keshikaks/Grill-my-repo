# Grill My Repo — Environment Configuration (Server-Side Only)
# Never prefix secrets with NEXT_PUBLIC_.
# Do NOT commit .env.local to Git.

# ==============================================================================
# Database Configuration (Neon PostgreSQL)
# ==============================================================================
# Neon pooled connection string for application queries
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon direct connection string for Prisma migrations
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# Authentication Configuration
# ==============================================================================
# Secret used to sign and verify session JWT tokens (generate with `openssl rand -hex 32`)
AUTH_SECRET=your_32_character_random_hex_secret_here

# ==============================================================================
# GitHub API Configuration (Optional, but recommended)
# ==============================================================================
# Increases rate limit from 60 req/hr (unauthenticated) to 5,000 req/hr
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ==============================================================================
# AI Provider Configuration (Optional)
# ==============================================================================
# Supported providers: "gemini" (default), "openai", "heuristic" (fallback when unset)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash

# ==============================================================================
# Email Service Configuration (Optional, for password reset emails)
# ==============================================================================
# SMTP_SERVER=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# RESEND_API_KEY=re_your_api_key
